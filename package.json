  "scripts": {
    "dev": "parcel serve src/index.html --port 2000 --dist-dir deploy",
    "build": "npm run build:clean && parcel build src/index.html --dist-dir deploy --public-url /",
    "build:clean": "rimraf deploy .parcel-cache",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/montserrat": "^4.3.0",
    "@fontsource/ubuntu": "^4.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2"
  },
  "engines": {
    "node": ">= 22",
    "npm": ">= 10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@parcel/packager-raw-url": "^2.16.0",
    "@parcel/transformer-sass": "^2.16.0",
    "@parcel/transformer-webmanifest": "^2.16.0",
    "parcel": "^2.12.0",
    "rimraf": "^6.0.1",
    "sass": "^1.79.5",
    "wrangler": "^4.42.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ]
}
